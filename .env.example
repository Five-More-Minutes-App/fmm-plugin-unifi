# Copy this file to .env and fill it in. .env is ignored by git; never commit it.

# --- Five More Minutes ------------------------------------------------------
# Where Five More Minutes can be reached from the computer this runs on.
FMM_URL=http://192.168.1.10:5072
# A key made in the Five More Minutes portal under Plugins. It needs only "state:read".
FMM_API_KEY=

# --- UniFi ------------------------------------------------------------------
# Your UniFi console (a Dream Machine, Cloud Key, ...) and a local account made for this plugin.
UNIFI_URL=https://192.168.1.1
UNIFI_USERNAME=fmm-plugin
UNIFI_PASSWORD=
# Usually "default".
#UNIFI_SITE=default
# "unifi-os" for a console (Dream Machine, Cloud Gateway, Cloud Key Gen2+),
# "classic" for a self-hosted Network Application on port 8443.
#UNIFI_KIND=unifi-os

# How to trust the console's certificate. Choose at most one. See the README, "Trusting the certificate".
# Run "docker compose run --rm unifi node src/main.js --check" to see the fingerprint.
#UNIFI_TLS_FINGERPRINT=
#UNIFI_CA_FILE=/data/ca.pem
#UNIFI_INSECURE_TLS=false

# --- The settings page ------------------------------------------------------
# The password for this plugin's settings page. At least 16 characters. Make one with:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_TOKEN=

# --- Behaviour (the defaults are good) --------------------------------------
# In "whenever no time is running" mode: how long Five More Minutes may be out of reach before
# everything is let back online. 30 to 86400.
#FAIL_OPEN_SECONDS=300
# How often it checks that what UniFi says matches what it should. 5 to 3600.
#RECONCILE_SECONDS=60
# Set to true if you put the settings page behind https.
#COOKIE_SECURE=false

# Every secret above can instead be a path to a file that holds it, for Docker or Kubernetes
# secrets: FMM_API_KEY_FILE, UNIFI_PASSWORD_FILE, ADMIN_TOKEN_FILE.
